{
    "name": "gedisa/laravel-simple-health-check",
    "description": "Laravel Simple Health Check",
    "type": "library",
    "prefer-stable": true,
    "license": "MIT",
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Gedisa\\LaravelSimpleHealthCheck\\": "src/",
            "Gedisa\\LaravelSimpleHealthCheck\\Tests\\": "tests"
        }
    },
    "scripts": {
        "pint": [
            "./vendor/bin/pint"
        ],
        "test": [
            "./vendor/bin/phpunit"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^8.17",
        "predis/predis": "^2.2",
        "josiasmontag/laravel-redis-mock": "^1.3",
        "laravel/pint": "^1.13"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gedisa\\LaravelSimpleHealthCheck\\Providers\\HealthCheckProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    }
}
