{
    "name": "anthonyvasiliuk/healthcheck",
    "description": "HealthCheck",
    "type": "library",
    "prefer-stable": true,
    "license": "MIT",
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "AnthonyVasiliuk\\HealthCheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnthonyVasiliuk\\HealthCheck\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": [
            "php artisan test tests/Feature/HealthCheckControllerTest.php"
        ]
    },
    "authors": [
        {
            "name": "anton.v",
            "email": "anton.v@northitgroup.eu"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "pestphp/pest-plugin-laravel": "^2.2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
