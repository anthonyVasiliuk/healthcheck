{
    "name": "anthonyvasiliuk/healthcheck",
    "description": "HealthCheck",
    "type": "library",
    "prefer-stable": true,
    "license": "MIT",
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "AnthonyVasiliuk\\HealthCheck\\": "src/",
            "AnthonyVasiliuk\\HealthCheck\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/pest tests/Feature"
        ]
    },
    "authors": [
        {
            "name": "anton.v",
            "email": "anton.v@northitgroup.eu"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "pestphp/pest-plugin-laravel": "^2.2",
        "orchestra/testbench": "^8.17",
        "pestphp/pest": "^2.28"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AnthonyVasiliuk\\HealthCheck\\Providers\\HealthCheckProvider"
            ]
        }
    }
}
