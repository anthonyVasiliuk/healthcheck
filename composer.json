{
    "name": "anthonyvasiliuk/healthcheck",
    "description": "HealthCheck",
    "type": "library",
    "prefer-stable": true,
    "license": "MIT",
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "AnthonyVasiliuk\\HealthCheck\\": "src/",
            "AnthonyVasiliuk\\HealthCheck\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/pest tests/Feature"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve"
        ]
    },
    "authors": [
        {
            "name": "anton.v",
            "email": "anton.v@northitgroup.eu"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^8.17",
        "predis/predis": "^2.2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AnthonyVasiliuk\\HealthCheck\\Providers\\HealthCheckProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "require": {
        "josiasmontag/laravel-redis-mock": "^1.3"
    }
}
